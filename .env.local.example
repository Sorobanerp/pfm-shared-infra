# ============================================================================
# PFM Core Banking V2 — Canonical Local Port Map (1xxxx Host Isolation)
# Prevents any collision with Portainer (8000/9000/9443) or OS services.
# Inside Docker/Kubernetes containers, standard internal ports remain unchanged.
# ============================================================================

# 1. Documentation & Frontend Portals
PFM_DOCS_PORT=18000
PFM_WEB_NEXTJS_PORT=18300
NEXT_PUBLIC_API_URL=http://localhost:18080
NEXT_PUBLIC_PFM_BFF_URL=http://localhost:18080
ANDROID_DEV_BASE_URL=http://10.0.2.2:18080/

# 2. Edge Gateway & Application Microservices
PFM_ENVOY_GATEWAY_PORT=18080
BFF_SERVER_PORT=18100
FORECAST_GRPC_PORT=18110
FORECAST_GRPC_ADDR=localhost:18110
CORE_LEDGER_SERVER_PORT=18200
CORE_LEDGER_GRPC_SERVER_PORT=18210
CORE_LEDGER_GRPC_ADDR=localhost:18210
AI_WORKER_PORT=18400

# 3. Data Stores, Event Backbone & Cloud Emulators
POSTGRES_CORE_LEDGER_PORT=15432
DB_URL=jdbc:postgresql://localhost:15432/pfm_core_ledger
POSTGRES_AI_RULES_PORT=15433
PFM_AI_RULES_DSN=postgresql://pfm_ai_user:pfm_ai_pass@localhost:15433/pfm_ai_rules
REDIS_PORT=16379
REDIS_ADDR=localhost:16379
KAFKA_EXTERNAL_PORT=19092
KAFKA_BROKERS=localhost:19092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_UI_PORT=18085
LOCALSTACK_PORT=14566
AWS_ENDPOINT_URL=http://localhost:14566
LOCALSTACK_ENDPOINT=http://localhost:14566
